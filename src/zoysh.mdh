#ifndef have_zshQszoysh_module
#define have_zshQszoysh_module

# ifndef IMPORTING_MODULE_zshQszoysh
#   define boot_ boot_zshQszoysh
#   define cleanup_ cleanup_zshQszoysh
#   define features_ features_zshQszoysh
#   define enables_ enables_zshQszoysh
#   define setup_ setup_zshQszoysh
#   define finish_ finish_zshQszoysh
# endif /* !IMPORTING_MODULE_zshQszoysh */

/* Module dependencies */
# define IMPORTING_MODULE_zshQsmain 1
# include "zsh.mdh"

